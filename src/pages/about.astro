---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import siteConfig from '../../site.config.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<MainLayout title="About" description={`About ${siteConfig.owner}.`}>
	<div class="page">
		<h1 class="page-title" data-reveal>About</h1>
		<div class="about">
			<div class="about-photo" data-reveal>
				<img
					src={`${base}/images/${siteConfig.profileImage}`}
					alt={`Portrait of ${siteConfig.owner}`}
					width="720"
					height="900"
					data-fade
					decoding="async"
				/>
			</div>
			<div class="prose" data-reveal>
				<AboutPage />
			</div>
		</div>
	</div>
</MainLayout>
