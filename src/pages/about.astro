---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import siteConfig from '../../site.config.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<MainLayout title="About" description={`About ${siteConfig.owner}.`}>
	<div class="page">
		<h1 class="page-title" data-reveal>About</h1>
		<div class="about">
			<figure class="about-photo" data-reveal>
				<img
					src={`${base}/images/${siteConfig.profileImage}`}
					alt="A rusted iron figure standing alone on a pale terrace above green hills."
					width="1600"
					height="1200"
					data-fade
					decoding="async"
				/>
			</figure>
			<div class="about-body" data-reveal>
				<p class="about-label">{siteConfig.owner}</p>
				<div class="prose">
					<AboutPage />
				</div>
			</div>
		</div>
	</div>
</MainLayout>
