---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import siteConfig from '../../site.config.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = `${base}/images/${siteConfig.profileImage}`;
---

<MainLayout title="About" description={`About ${siteConfig.owner}.`}>
	<div class="page">
		<div class="about">
			<div class="about-text" data-reveal>
				<h1 class="page-title">{siteConfig.owner}</h1>
				<div class="prose">
					<AboutPage />
				</div>
			</div>
			<a
				class="about-photo"
				href={photo}
				data-reveal
				data-lightbox
				data-full={photo}
				data-w="1600"
				data-h="1200"
				aria-label="View photo full screen"
			>
				<img src={photo} alt="" width="1600" height="1200" data-fade decoding="async" />
			</a>
		</div>
	</div>
</MainLayout>
