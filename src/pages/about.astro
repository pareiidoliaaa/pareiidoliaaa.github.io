---
import MainLayout from '../layouts/MainLayout.astro';
import { Content as AboutPage } from '../content/about.md';
import siteConfig from '../../site.config.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photo = `${base}/images/${siteConfig.profileImage}`;
const alt = 'A rusted iron figure standing alone on a pale terrace above green hills.';
---

<MainLayout title="About" description={`About ${siteConfig.owner}.`}>
	<div class="page">
		<h1 class="page-title" data-reveal>About</h1>
		<div class="about">
			<div class="prose" data-reveal>
				<AboutPage />
			</div>
			<a
				class="about-photo"
				href={photo}
				data-reveal
				data-lightbox
				data-full={photo}
				data-w="1600"
				data-h="1200"
				data-title={alt}
				aria-label="View photo full screen"
			>
				<img src={photo} alt={alt} width="1600" height="1200" data-fade decoding="async" />
			</a>
		</div>
	</div>
</MainLayout>
